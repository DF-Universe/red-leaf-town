{
  "id": "summer_chapter_8",
  "title": "第 8 章",
  "priority": 0,
  "trigger": {
    "hook": "all_of",
    "repeatable": true,
    "params": {
      "conditions": [
        {
          "hook": "cue",
          "params": {
            "cue": "summer:summer_chapter_8"
          }
        },
        {
          "hook": "season_progress",
          "params": {
